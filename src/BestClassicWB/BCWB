PROTECT "SYS:WBStartup/ClickNot" +e

; Copy readme file
COPY BCWB.readme.txt TO SYS:Locale/Help
COPY BCWB.readme.txt.info TO SYS:Locale/Help

; End of script.

ECHO ""
ECHO ""
ECHO "Installation complete."
ECHO "Reboot your Amiga, and enjoy!"
ECHO ""
ECHO "Goodbye"
WAIT 5 sec
QUIT
