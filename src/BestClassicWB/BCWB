PROTECT "SYS:C/xadUnFileM" +e
PROTECT "SYS:C/xadUnTar" +e
PROTECT "SYS:C/xfdDecrunch" +e
PROTECT "SYS:C/xfdDecrunchAddr" +e
PROTECT "SYS:C/xfdLibInfo" +e
